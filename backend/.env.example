# Copy to backend/.env and fill in. Never commit the real file (it is git-ignored).
#
# You need at least ONE key for the interviewer model and ONE speech-to-text key.
# Ollama Cloud has no speech-to-text endpoint, so STT uses Groq (free tier) or OpenRouter (paid, cheap).

# --- Ollama Cloud (chat + vision; https://ollama.com/settings/keys) ---
OLLAMA_API_KEY=
# Point at a local Ollama server instead (no key needed):  OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Groq (fast chat + Whisper speech-to-text; https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- OpenRouter (fallback chat, free ':free' models, paid STT; https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=

# --- GitHub (optional; raises the repo-analysis limit from 60 to 5000 requests/hour) ---
GITHUB_TOKEN=

# --- Which model does what: "provider:model" lists, first available wins, the rest are fallbacks ---
# Defaults were measured live (see README). Reasoning-by-default models are avoided on the live path.
# LIVE_CHAIN=groq:qwen/qwen3.8-27b,ollama:gemma4:31b,ollama:mistral-large-3:675b,openrouter:google/gemma-4-31b-it:free
# VISION_CHAIN=ollama:gemma4:31b,openrouter:google/gemma-4-31b-it:free,ollama:kimi-k2.6
# COUNCIL_CHAIN=ollama:gemma4:31b,groq:qwen/qwen3.8-27b,ollama:mistral-large-3:675b,ollama:glm-5.3-flash
# STT_CHAIN=groq:whisper-large-v3-turbo,groq:whisper-large-v3
# OpenRouter speech-to-text is paid only (HTTP 402 until you buy credits); add it only if you have credits:
# STT_CHAIN=groq:whisper-large-v3-turbo,groq:whisper-large-v3,openrouter:openai/whisper-large-v3-turbo
# COUNCIL_SIZE=3

# --- Access / privacy ---
# ACCESS_CODE=            # require this code to start an interview (recommended on any public deployment)
# RETENTION_DAYS=30       # sessions older than this are deleted at startup
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TRUST_PROXY=0           # set 1 behind Render/Cloudflare so rate limits see the real client IP
# MAX_CONCURRENT_SESSIONS=2   # one live session can have 2 requests in flight; Ollama Pro allows 3

# --- Turn taking ---
# PAUSE_SECONDS=2.5          # silence before Nova may speak (pauses are thinking time)
# MIN_AI_GAP_SECONDS=20
# MIN_WORDS_TO_ASK=35
